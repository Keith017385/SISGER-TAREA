{
	"name": "df_entregas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "entregas_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "entregas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as string,",
				"          hora_entrega as string,",
				"          tiempo_entrega_min as string,",
				"          distancia_km as string,",
				"          estado_entrega as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(hora_entrega = iif(\r",
				"    isNull(hora_entrega) || trim(hora_entrega) == '',\r",
				"    toTimestamp(null(), 'yyyy-MM-dd HH:mm:ss'),\r",
				"    toTimestamp(trim(hora_entrega), 'yyyy-MM-dd HH:mm:ss')\r",
				"),",
				"          hora_salida = iif(\r",
				"    isNull(hora_salida) || trim(hora_salida) == '',\r",
				"    toTimestamp(null(), 'yyyy-MM-dd HH:mm:ss'),\r",
				"    toTimestamp(trim(hora_salida), 'yyyy-MM-dd HH:mm:ss')\r",
				"),",
				"          distancia_km = toDecimal(trim(toString(distancia_km)), 10, 2),",
				"          tiempo_entrega_min = toInteger(trim(toString(tiempo_entrega_min)))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(entrega_id)\r",
				"&& trim(entrega_id) != ''\r",
				"&& !isNull(pedido_id)\r",
				"&& trim(pedido_id) != ''\r",
				"&& !isNull(repartidor_id)\r",
				"&& trim(repartidor_id) != ''\r",
				"&& !isNull(hora_salida)\r",
				"&& !isNull(tiempo_entrega_min)\r",
				"&& tiempo_entrega_min >= 0\r",
				"&& !isNull(distancia_km)\r",
				"&& distancia_km >= 0\r",
				"&& !isNull(estado_entrega)\r",
				"&& trim(estado_entrega) != '',",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(repartidor_id),",
				"     entrega_id = count(entrega_id),",
				"          tiempo_entrega_min = avg(tiempo_entrega_min),",
				"          distancia_km = sum(distancia_km),",
				"          hora_salida = first(hora_salida),",
				"          hora_entrega = first(hora_entrega),",
				"          estado_entrega = first(estado_entrega),",
				"          pedido_id = first(pedido_id)) ~> aggregate1",
				"aggregate1 derive(tiempo_entrega_min = toDecimal(tiempo_entrega_min,10,2)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          fecha_entrega as date,",
				"          tiempo_entrega_min as integer,",
				"          estado_entrega as string,",
				"          costo_envio as decimal(10,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          entrega_id,",
				"          pedido_id,",
				"          repartidor_id,",
				"          tiempo_entrega_min,",
				"          estado_entrega,",
				"          fecha_entrega = hora_entrega,",
				"          costo_envio = tiempo_entrega_min",
				"     )) ~> sink1"
			]
		}
	}
}