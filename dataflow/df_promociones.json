{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "promociones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(promocion_id = iif(isNull(promocion_id), '', trim(promocion_id)),",
				"          nombre_promocion = iif(isNull(nombre_promocion), '', trim(nombre_promocion)),",
				"          fecha_inicio = iif(isNull(fecha_inicio), '', trim(fecha_inicio)),",
				"          fecha_fin = iif(isNull(fecha_fin), '', trim(fecha_fin)),",
				"          porcentaje_descuento = iif(isNull(porcentaje_descuento), '', trim(porcentaje_descuento)),",
				"          canal_aplicable = iif(isNull(canal_aplicable), '', trim(canal_aplicable))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(promocion_id)\r",
				"&& promocion_id != ''\r",
				"&& !isNull(nombre_promocion)\r",
				"&& nombre_promocion != ''\r",
				"&& !isNull(fecha_inicio)\r",
				"&& fecha_inicio != ''\r",
				"&& !isNull(fecha_fin)\r",
				"&& fecha_fin != ''\r",
				"&& !isNull(porcentaje_descuento)\r",
				"&& porcentaje_descuento != ''\r",
				"&& !isNull(canal_aplicable)\r",
				"&& canal_aplicable != ''\r",
				"&& regexMatch(fecha_inicio, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$')\r",
				"&& regexMatch(fecha_fin, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$')\r",
				"&& isDate(fecha_inicio, 'yyyy-MM-dd')\r",
				"&& isDate(fecha_fin, 'yyyy-MM-dd')\r",
				"&& regexMatch(porcentaje_descuento, '^[0-9]+([.][0-9]+)?$')\r",
				"&& toDecimal(porcentaje_descuento, 10, 2) > 0\r",
				"&& toDecimal(porcentaje_descuento, 10, 2) <= 100\r",
				"&& toDate(fecha_fin, 'yyyy-MM-dd')\r",
				"   >= toDate(fecha_inicio, 'yyyy-MM-dd'),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          porcentaje_descuento as decimal(5,2),",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          activa as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}