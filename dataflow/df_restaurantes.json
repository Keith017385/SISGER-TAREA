{
	"name": "df_restaurantes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "restaurantes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "restaurantes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(restaurante_id = iif(isNull(restaurante_id), '', trim(restaurante_id)),",
				"          nombre_restaurante = iif(isNull(nombre_restaurante), '', trim(nombre_restaurante)),",
				"          tipo_cocina = iif(isNull(tipo_cocina), '', trim(tipo_cocina)),",
				"          calificacion_promedio = iif(isNull(calificacion_promedio), '', trim(toString(calificacion_promedio))),",
				"          activo = iif(isNull(activo), '', trim(activo))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(restaurante_id)\r",
				"&& trim(restaurante_id) != ''\r",
				"&& !isNull(nombre_restaurante)\r",
				"&& trim(nombre_restaurante) != ''\r",
				"&& !isNull(tipo_cocina)\r",
				"&& trim(tipo_cocina) != ''\r",
				"&& !isNull(calificacion_promedio)\r",
				"&& trim(calificacion_promedio) != ''\r",
				"&& isDecimal(calificacion_promedio)\r",
				"&& toDecimal(calificacion_promedio) >= 0\r",
				"&& toDecimal(calificacion_promedio) <= 5\r",
				"&& !isNull(activo)\r",
				"&& trim(activo) != ''\r",
				"&& (\r",
				"    activo == 'Sí'\r",
				"    ||\r",
				"    activo == 'No'\r",
				"),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(calificacion_promedio = toDecimal(calificacion_promedio)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as decimal(3,2),",
				"          activo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          restaurante_id,",
				"          nombre_restaurante,",
				"          tipo_cocina,",
				"          calificacion_promedio,",
				"          activo",
				"     )) ~> sink1"
			]
		}
	}
}