{
	"name": "df_productos_menu",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "productos_menu_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "productos_menu_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as string,",
				"          costo_estimado as string,",
				"          disponible as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(producto_id = iif(isNull(producto_id), '', trim(producto_id)),",
				"          nombre_producto = iif(isNull(nombre_producto), '', trim(nombre_producto)),",
				"          categoria = iif(isNull(categoria), '', trim(categoria)),",
				"          precio_lista = iif(isNull(precio_lista), '', trim(replace(precio_lista, 'Bs ', ''))),",
				"          costo_estimado = iif(isNull(costo_estimado), '', trim(costo_estimado)),",
				"          disponible = iif(isNull(disponible), '', upper(trim(disponible)))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(producto_id)\r",
				"&& producto_id != ''\r",
				"&& !isNull(nombre_producto)\r",
				"&& nombre_producto != ''\r",
				"&& !isNull(categoria)\r",
				"&& categoria != ''\r",
				"&& !isNull(precio_lista)\r",
				"&& precio_lista != ''\r",
				"&& !isNull(costo_estimado)\r",
				"&& costo_estimado != ''\r",
				"&& !isNull(disponible)\r",
				"&& disponible!= '',",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(producto_id),",
				"     nombre_producto = first(nombre_producto),",
				"          categoria = first(categoria),",
				"          precio_lista = first(precio_lista),",
				"          costo_estimado = first(costo_estimado),",
				"          disponible = first(disponible)) ~> aggregate1",
				"aggregate1 derive(producto_id = toString(producto_id),",
				"          nombre_producto = toString(nombre_producto),",
				"          categoria = toString(categoria),",
				"          precio_lista = toDecimal(precio_lista,10,2),",
				"          costo_estimado = toDecimal(costo_estimado,10,2)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          producto_id as string,",
				"          restaurante_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio as decimal(10,2),",
				"          disponible as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          producto_id,",
				"          nombre_producto,",
				"          categoria,",
				"          precio = precio_lista,",
				"          disponible",
				"     )) ~> sink1"
			]
		}
	}
}