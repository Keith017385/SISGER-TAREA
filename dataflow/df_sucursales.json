{
	"name": "df_sucursales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sucursales_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sucursales_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as string,",
				"          tiene_delivery as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(sucursal_id = iif(isNull(sucursal_id), '', trim(sucursal_id)),",
				"          restaurante_id = iif(isNull(restaurante_id), '', trim(restaurante_id)),",
				"          nombre_sucursal = iif(isNull(nombre_sucursal), '', trim(nombre_sucursal)),",
				"          ciudad = iif(isNull(ciudad), '', trim(ciudad)),",
				"          zona = iif(isNull(zona), '', trim(zona)),",
				"          direccion = iif(isNull(direccion), '', trim(direccion)),",
				"          capacidad_mesas = iif(isNull(capacidad_mesas), '', trim(capacidad_mesas)),",
				"          tiene_delivery = iif(isNull(tiene_delivery), '', trim(tiene_delivery))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(sucursal_id)\r",
				"&& trim(sucursal_id) != ''\r",
				"&& !isNull(restaurante_id)\r",
				"&& trim(restaurante_id) != ''\r",
				"&& !isNull(nombre_sucursal)\r",
				"&& trim(nombre_sucursal) != ''\r",
				"&& !isNull(ciudad)\r",
				"&& trim(ciudad) != ''\r",
				"&& !isNull(zona)\r",
				"&& trim(zona) != ''\r",
				"&& !isNull(direccion)\r",
				"&& trim(direccion) != ''\r",
				"&& !isNull(capacidad_mesas)\r",
				"&& trim(capacidad_mesas) != ''\r",
				"&& regexMatch(trim(capacidad_mesas), '^[0-9]+$')\r",
				"&& toInteger(capacidad_mesas) > 0\r",
				"&& !isNull(tiene_delivery)\r",
				"&& trim(tiene_delivery) != ''\r",
				"&& (\r",
				"    lower(trim(tiene_delivery)) == 'sí'\r",
				"    ||\r",
				"    lower(trim(tiene_delivery)) == 'no'\r",
				"),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(capacidad_mesas = toInteger(capacidad_mesas)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          direccion as string,",
				"          ciudad as string,",
				"          telefono as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          sucursal_id,",
				"          restaurante_id,",
				"          nombre_sucursal,",
				"          direccion,",
				"          ciudad",
				"     )) ~> sink1"
			]
		}
	}
}