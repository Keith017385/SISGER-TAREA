{
	"name": "df_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "pedidos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pedido_id as string,",
				"          fecha_pedido as string,",
				"          hora_pedido as string,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as string,",
				"          costo_delivery as string,",
				"          descuento as string,",
				"          impuesto as string,",
				"          total_pedido as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(fecha_pedido = toDate(fecha_pedido, 'yyyy-MM-dd'),",
				"          hora_pedido = iif(\r",
				"    isNull(hora_pedido),\r",
				"    '',\r",
				"    trim(hora_pedido)\r",
				"),",
				"          canal = iif(\r",
				"    isNull(canal),\r",
				"    '',\r",
				"    iif(\r",
				"        trim(canal) == 'APP',\r",
				"        'Aplicación',\r",
				"        trim(canal)\r",
				"    )\r",
				"),",
				"          tipo_servicio = iif(\r",
				"    isNull(tipo_servicio),\r",
				"    '',\r",
				"    trim(tipo_servicio)\r",
				"),",
				"          estado_pedido = iif(\r",
				"    isNull(estado_pedido),\r",
				"    '',\r",
				"    trim(estado_pedido)\r",
				"),",
				"          promocion_id = iif(\r",
				"    isNull(promocion_id),\r",
				"    '',\r",
				"    trim(promocion_id)\r",
				"),",
				"          subtotal = iif(\r",
				"    isNull(subtotal) || trim(subtotal) == '',\r",
				"    toDecimal(0,18,2),\r",
				"    toDecimal(trim(subtotal),18,2)\r",
				"),",
				"          impuesto = iif(\r",
				"    isNull(impuesto) || trim(impuesto) == '',\r",
				"    toDecimal(0,18,2),\r",
				"    toDecimal(trim(impuesto),18,2)\r",
				"),",
				"          total_pedido = iif(     isNull(total_pedido) || trim(total_pedido) == '',     toDecimal(0,18,2),     toDecimal(trim(total_pedido),18,2) )) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(pedido_id) && trim(pedido_id) != '' &&\r",
				"!isNull(fecha_pedido) &&\r",
				"!isNull(hora_pedido) && trim(hora_pedido) != '' &&\r",
				"!isNull(cliente_id) && trim(cliente_id) != '' &&\r",
				"!isNull(sucursal_id) && trim(sucursal_id) != '' &&\r",
				"!isNull(canal) && trim(canal) != '' &&\r",
				"!isNull(tipo_servicio) && trim(tipo_servicio) != '' &&\r",
				"!isNull(estado_pedido) && trim(estado_pedido) != '' &&\r",
				"!isNull(subtotal) &&\r",
				"!isNull(costo_delivery) &&\r",
				"!isNull(descuento) &&\r",
				"!isNull(impuesto) &&\r",
				"!isNull(total_pedido)&&\r",
				"!isNull(promocion_id) && trim(promocion_id) != '',",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(estado_pedido),",
				"     total_pedido = sum(total_pedido),",
				"          subtotal = sum(subtotal),",
				"          impuesto = sum(impuesto),",
				"          pedido_id = first(pedido_id),",
				"          fecha_pedido = first(fecha_pedido),",
				"          hora_pedido = first(hora_pedido),",
				"          cliente_id = first(cliente_id),",
				"          sucursal_id = first(sucursal_id),",
				"          canal = first(canal),",
				"          tipo_servicio = first(tipo_servicio),",
				"          promocion_id = first(promocion_id),",
				"          costo_delivery = first(costo_delivery),",
				"          descuento = first(descuento)) ~> aggregate1",
				"aggregate1 derive(costo_delivery = toDecimal(costo_delivery,10,2),",
				"          descuento = toInteger(descuento)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          pedido_id as string,",
				"          cliente_id as string,",
				"          restaurante_id as string,",
				"          sucursal_id as string,",
				"          repartidor_id as string,",
				"          fecha_pedido as date,",
				"          monto_total as decimal(10,2),",
				"          metodo_pago as string,",
				"          estado_pedido as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          pedido_id,",
				"          cliente_id,",
				"          restaurante_id = canal,",
				"          sucursal_id,",
				"          repartidor_id = promocion_id,",
				"          fecha_pedido,",
				"          monto_total = subtotal,",
				"          metodo_pago = tipo_servicio,",
				"          estado_pedido",
				"     )) ~> sink1"
			]
		}
	}
}